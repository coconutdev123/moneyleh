{
  "name": "moneyleh",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter moneywhere dev",
    "build:web": "bun run --filter moneywhere build",
    "typecheck:web": "bun run --filter moneywhere typecheck",
    "lint:web": "bun run --filter moneywhere lint",
    "preview:web": "bun run --filter moneywhere preview",
    "start:mobile": "bun run --filter @moneyleh/mobile start",
    "web:mobile": "bun run --filter @moneyleh/mobile web",
    "android:mobile": "bun run --filter @moneyleh/mobile android",
    "ios:mobile": "bun run --filter @moneyleh/mobile ios",
    "typecheck:mobile": "bun run --filter @moneyleh/mobile typecheck",
    "lint:mobile": "bun run --filter @moneyleh/mobile lint"
  }
}
